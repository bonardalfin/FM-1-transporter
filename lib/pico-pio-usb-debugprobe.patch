 .define public IRQ_TX_EOP 0   ; EOP start flag bit
 
 ; USB NRZI transmitter
-; Run at 48 MHz for full-spped (x4)
-; Run at 6 MHz for low-spped (x4)
+; Run at 24 MHz for full-spped (x2)
+; Run at 3 MHz for low-spped (x2)
+; Raspberry Pi Debug Probe: three side-set pins, D+ at the base, D- two above
+; (the pin between is never enabled), and half the clock so the delays fit
 ; autopull enabled
 ; Should be placed at address 0
 .program usb_tx_dpdm
-.side_set 2
+.side_set 3
 
 ; J for fs, K for ls
-.define FJ_LK 0b01
+.define FJ_LK 0b001
 ; K for fs, J for ls
-.define FK_LJ 0b10
-.define SE0 0b00
+.define FK_LJ 0b100
+.define SE0 0b000
 
-irq IRQ_TX_EOP      side SE0 [7]
+irq IRQ_TX_EOP      side SE0 [3]
 reset:
 .wrap_target
-out pc, 2           side FJ_LK [3]
-set pindirs, 0b00   side FJ_LK [3]
-out pc, 2           side FK_LJ [3]
+out pc, 2           side FJ_LK [1]
+set pindirs, 0b000   side FJ_LK [1]
+out pc, 2           side FK_LJ [1]
 start:
-set pindirs, 0b11   side FJ_LK
+set pindirs, 0b101   side FJ_LK
 .wrap
 
 ; USB transmitter for PRE packet (No EOP)
-; Run at 48 MHz for full-spped
+; Run at 24 MHz for full-spped
 ; autopull enabled
 .program usb_tx_pre_dpdm
